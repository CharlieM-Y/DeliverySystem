@page
@model DeliverySystem.Pages.OfficeStaffViewModel
@using DeliverySystem.Models

@{
    ViewData["Title"] = "Office Staff Dashboard";
}

<div class="container mt-4">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Office Staff Dashboard</h1>

            <p class="text-muted">
                Welcome, @Model.CurrentStaff?.Name
            </p>
        </div>

        <a asp-page="/Index"
           class="btn btn-outline-secondary">
            Switch Account
        </a>

    </div>

    <!-- MESSAGES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
             class="alert alert-danger"></div>
    }

    <!-- SUMMARY CARDS -->

    <div class="row mb-4">

        <div class="col-md-3 mb-3">
            <div class="card bg-light h-100">
                <div class="card-body">
                    <h6>Total Accounts</h6>
                    <h2>@Model.TotalAccounts</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card bg-light h-100">
                <div class="card-body">
                    <h6>Total Deliveries</h6>
                    <h2>@Model.TotalDeliveries</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card bg-light h-100">
                <div class="card-body">
                    <h6>Requests Awaiting Quote</h6>
                    <h2>@Model.PendingRequests</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card bg-light h-100">
                <div class="card-body">
                    <h6>Unassigned Deliveries</h6>
                    <h2>@Model.UnassignedDeliveries</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- PAGE NAVIGATION -->

    <ul class="nav nav-pills mb-4">

        <li class="nav-item">
            <a class="nav-link" href="#createAccount">
                Create Account
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" href="#deliveryRequests">
                Delivery Requests
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" href="#accounts">
                All Accounts
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" href="#deliveries">
                All Deliveries
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" href="#assignDelivery">
                Assign Delivery
            </a>
        </li>

    </ul>

    <!-- ===================================== -->
    <!-- CREATE ACCOUNT -->
    <!-- ===================================== -->

    <section id="createAccount" class="card mb-4">

        <div class="card-header">
            <h4>Create Account</h4>
        </div>

        <div class="card-body">

            <form method="post"
                  asp-page-handler="CreateAccount">

                <!-- ACCOUNT TYPE -->

                <div class="mb-3">

                    <label class="form-label">
                        Account Type
                    </label>

                    <select asp-for="AccountInput.AccountType"
                            class="form-select"
                            id="accountType"
                            onchange="showAccountFields()">

                        <option value="Customer">
                            Customer
                        </option>

                        <option value="OfficeStaff">
                            Office Staff
                        </option>

                        <option value="DeliveryStaff">
                            Delivery Staff
                        </option>

                    </select>

                </div>

                <!-- NAME -->

                <div class="mb-3">

                    <label asp-for="AccountInput.Name"
                           class="form-label">
                        Full Name
                    </label>

                    <input asp-for="AccountInput.Name"
                           class="form-control" />

                </div>

                <!-- EMAIL -->

                <div class="mb-3">

                    <label asp-for="AccountInput.Email"
                           class="form-label">
                        Email Address
                    </label>

                    <input asp-for="AccountInput.Email"
                           type="email"
                           class="form-control" />

                </div>

                <!-- PASSWORD -->

                <div class="mb-3">

                    <label asp-for="AccountInput.Password"
                           class="form-label">
                        Password
                    </label>

                    <input asp-for="AccountInput.Password"
                           type="password"
                           class="form-control" />

                </div>

                <!-- CUSTOMER FIELDS -->

                <div id="customerFields">

                    <div class="mb-3">

                        <label asp-for="AccountInput.DeliveryAddress"
                               class="form-label">
                            Delivery Address
                        </label>

                        <input asp-for="AccountInput.DeliveryAddress"
                               class="form-control" />

                    </div>

                </div>

                <!-- OFFICE STAFF FIELDS -->

                <div id="officeStaffFields" style="display:none;">

                    <div class="mb-3">

                        <label asp-for="AccountInput.Department"
                               class="form-label">
                            Department
                        </label>

                        <input asp-for="AccountInput.Department"
                               class="form-control" />

                    </div>

                </div>

                <!-- DELIVERY STAFF FIELDS -->

                <div id="deliveryStaffFields" style="display:none;">

                    <div class="form-check mb-3">

                        <input asp-for="AccountInput.IsAvailable"
                               class="form-check-input" />

                        <label asp-for="AccountInput.IsAvailable"
                               class="form-check-label">
                            Available / Clocked In
                        </label>

                    </div>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Create Account
                </button>

            </form>

        </div>

    </section>

    <!-- ===================================== -->
    <!-- DELIVERY REQUESTS AND QUOTES -->
    <!-- ===================================== -->

    <section id="deliveryRequests" class="card mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h4 class="mb-0">Delivery Requests & Quotes</h4>

            <span class="badge bg-secondary">
                @Model.DeliveryRequests.Count Requests
            </span>

        </div>

        <div class="card-body">

            <p class="text-muted">
                Review customer delivery requests and provide quotes.
                Once a customer accepts a quote, an actual delivery
                will be created automatically.
            </p>

            @if (!Model.DeliveryRequests.Any())
            {
                <div class="alert alert-info">
                    No delivery requests have been submitted.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-bordered align-middle">

                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Customer</th>
                                <th>Created</th>
                                <th>Pickup</th>
                                <th>Destination</th>
                                <th>Parcels</th>
                                <th>Status</th>
                                <th>Quote</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var request in Model.DeliveryRequests)
                            {
                                <tr>

                                    <!-- REQUEST ID -->

                                    <td>
                                        <small>
                                            @request.Id.ToString()[..8]
                                        </small>
                                    </td>

                                    <!-- CUSTOMER -->

                                    <td>

                                        <strong>
                                            @request.Customer?.Name
                                        </strong>

                                        <br />

                                        <small class="text-muted">
                                            @request.Customer?.Email
                                        </small>

                                    </td>

                                    <!-- CREATED -->

                                    <td>
                                        @(request.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                                    </td>

                                    <!-- PICKUP -->

                                    <td>
                                        @request.PickupAddress
                                    </td>

                                    <!-- DESTINATION -->

                                    <td>
                                        @request.DeliveryAddress
                                    </td>

                                    <!-- PARCEL DETAILS -->

                                    <td>

                                        @if (request.Parcels.Any())
                                        {
                                            @foreach (var parcel in request.Parcels)
                                            {
                                                <div class="mb-2">

                                                    <strong>Weight:</strong>
                                                    @parcel.Weight kg

                                                    <br />

                                                    <strong>Dimensions:</strong>
                                                    @parcel.Length x
                                                    @parcel.Width x
                                                    @parcel.Height cm

                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No parcels
                                            </span>
                                        }

                                    </td>

                                    <!-- REQUEST STATUS -->

                                    <td>

                                        @switch (request.Status)
                                        {
                                            case DeliveryRequestStatus.PendingReview:

                                                <span class="badge bg-warning text-dark">
                                                    Pending Review
                                                </span>
                                                break;

                                            case DeliveryRequestStatus.AwaitingResponse:

                                                <span class="badge bg-info text-dark">
                                                    Awaiting Response
                                                </span>
                                                break;

                                            case DeliveryRequestStatus.Accepted:

                                                <span class="badge bg-success">
                                                    Accepted
                                                </span>
                                                break;

                                            case DeliveryRequestStatus.Declined:

                                                <span class="badge bg-danger">
                                                    Declined
                                                </span>
                                                break;
                                        }

                                    </td>

                                    <!-- EXISTING QUOTE -->

                                    <td>

                                        @if (request.QuotedCost.HasValue)
                                        {
                                            <strong>
                                                @request.QuotedCost.Value.ToString("C")
                                            </strong>

                                            <div class="small mt-2">

                                                <strong>Pickup:</strong>

                                                <br />

                                                @(request.EstimatedPickupTime?.ToString("dd/MM/yyyy HH:mm"))

                                            </div>

                                            <div class="small mt-2">

                                                <strong>Delivery:</strong>

                                                <br />

                                                @(request.EstimatedDeliveryTime?.ToString("dd/MM/yyyy HH:mm"))

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not quoted
                                            </span>
                                        }

                                    </td>

                                    <!-- QUOTE FORM / ACTION -->

                                    <td>

                                        @if (request.Status ==
                                       DeliveryRequestStatus.PendingReview)
                                        {
                                            <form method="post"
                                                  asp-page-handler="QuoteRequest">

                                                <input type="hidden"
                                                       name="QuoteInput.RequestId"
                                                       value="@request.Id" />

                                                <!-- QUOTED COST -->

                                                <div class="mb-2">

                                                    <label class="form-label">
                                                        Quoted Cost ($)
                                                    </label>

                                                    <input type="number"
                                                           name="QuoteInput.QuotedCost"
                                                           min="0.01"
                                                           step="0.01"
                                                           class="form-control"
                                                           required />

                                                </div>

                                                <!-- PICKUP TIME -->

                                                <div class="mb-2">

                                                    <label class="form-label">
                                                        Estimated Pickup
                                                    </label>

                                                    <input type="datetime-local"
                                                           name="QuoteInput.EstimatedPickupTime"
                                                           class="form-control"
                                                           required />

                                                </div>

                                                <!-- DELIVERY TIME -->

                                                <div class="mb-2">

                                                    <label class="form-label">
                                                        Estimated Delivery
                                                    </label>

                                                    <input type="datetime-local"
                                                           name="QuoteInput.EstimatedDeliveryTime"
                                                           class="form-control"
                                                           required />

                                                </div>

                                                <button type="submit"
                                                        class="btn btn-primary btn-sm w-100">
                                                    Send Quote
                                                </button>

                                            </form>
                                        }
                                        else if (request.Status ==
                                        DeliveryRequestStatus.AwaitingResponse)
                                        {
                                            <span class="text-info">
                                                Waiting for Customer
                                            </span>
                                        }
                                        else if (request.Status ==
                                        DeliveryRequestStatus.Accepted)
                                        {
                                            <span class="text-success">
                                                Delivery Created
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Quote Declined
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </section>

    <!-- ===================================== -->
    <!-- ALL ACCOUNTS -->
    <!-- ===================================== -->

    <section id="accounts" class="card mb-4">

        <div class="card-header">
            <h4>All Accounts</h4>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-bordered">

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Account Type</th>
                            <th>Additional Information</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var account in Model.Accounts)
                        {
                            <tr>

                                <td>@account.Name</td>

                                <td>@account.Email</td>

                                <td>
                                    @account.GetType().Name
                                </td>

                                <td>

                                    @if (account is Customer customer)
                                    {
                                        <span>
                                            <strong>Delivery Address:</strong>
                                            @customer.DeliveryAddress
                                        </span>
                                    }
                                    else if (account is OfficeStaff staff)
                                    {
                                        <span>
                                            <strong>Department:</strong>
                                            @staff.Department
                                        </span>
                                    }
                                    else if (account is DeliveryStaff driver)
                                    {
                                        <strong>Availability:</strong>

                                        @if (driver.IsAvailable)
                                        {
                                            <span class="badge bg-success">
                                                Clocked In
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Clocked Out
                                            </span>
                                        }
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </section>

    <!-- ===================================== -->
    <!-- ALL DELIVERIES -->
    <!-- ===================================== -->

    <section id="deliveries" class="card mb-4">

        <div class="card-header">
            <h4>All Deliveries</h4>
        </div>

        <div class="card-body">

            @if (!Model.Deliveries.Any())
            {
                <div class="alert alert-info">
                    No deliveries have been created yet.
                    Deliveries are created when customers accept quotes.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-bordered align-middle">

                        <thead>
                            <tr>
                                <th>Delivery ID</th>
                                <th>Customer</th>
                                <th>Status</th>
                                <th>Assigned Staff</th>
                                <th>Created</th>
                                <th>Parcels</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var delivery in Model.Deliveries)
                            {
                                <tr>

                                    <!-- DELIVERY ID -->

                                    <td>
                                        <small>
                                            @delivery.Id.ToString()[..8]
                                        </small>
                                    </td>

                                    <!-- CUSTOMER -->

                                    <td>
                                        <strong>
                                            @delivery.Customer?.Name
                                        </strong>

                                        <br />

                                        <small class="text-muted">
                                            @delivery.Customer?.Email
                                        </small>
                                    </td>

                                    <!-- STATUS -->

                                    <td>

                                        @switch (delivery.Status)
                                        {
                                            case DeliveryStatus.Pending:

                                                <span class="badge bg-warning text-dark">
                                                    Pending
                                                </span>
                                                break;

                                            case DeliveryStatus.Allocated:

                                                <span class="badge bg-info text-dark">
                                                    Allocated
                                                </span>
                                                break;

                                            case DeliveryStatus.ReadyForDelivery:

                                                <span class="badge bg-primary">
                                                    Ready for Delivery
                                                </span>
                                                break;

                                            case DeliveryStatus.PickedUp:

                                                <span class="badge bg-primary">
                                                    Picked Up
                                                </span>
                                                break;

                                            case DeliveryStatus.Delivered:

                                                <span class="badge bg-success">
                                                    Delivered
                                                </span>
                                                break;

                                            case DeliveryStatus.Failed:

                                                <span class="badge bg-danger">
                                                    Failed
                                                </span>
                                                break;
                                        }

                                    </td>

                                    <!-- ASSIGNED STAFF -->

                                    <td>

                                        @if (delivery.DeliveryStaff != null)
                                        {
                                            @delivery.DeliveryStaff.Name
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Unassigned
                                            </span>
                                        }

                                    </td>

                                    <!-- CREATED -->

                                    <td>
                                        @(delivery.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                                    </td>

                                    <!-- PARCELS -->

                                    <td>

                                        @if (delivery.Parcels.Any())
                                        {
                                            @foreach (var parcel in delivery.Parcels)
                                            {
                                                <div class="mb-2">

                                                    <strong>Weight:</strong>
                                                    @parcel.Weight kg

                                                    <br />

                                                    <strong>Dimensions:</strong>
                                                    @parcel.Length x
                                                    @parcel.Width x
                                                    @parcel.Height cm

                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No parcels
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </section>

    <!-- ===================================== -->
    <!-- ASSIGN DELIVERY STAFF -->
    <!-- ===================================== -->

    <section id="assignDelivery" class="card mb-5">

        <div class="card-header">
            <h4>Assign Delivery Staff</h4>
        </div>

        <div class="card-body">

            <p class="text-muted">
                Assign a delivery to a staff member who is currently
                clocked in and available.
            </p>

            <form method="post"
                  asp-page-handler="AssignDelivery">

                <!-- DELIVERY -->

                <div class="mb-3">

                    <label asp-for="AssignmentInput.DeliveryId"
                           class="form-label">
                        Select Delivery
                    </label>

                    <select asp-for="AssignmentInput.DeliveryId"
                            class="form-select">

                        <option value="">
                            -- Select Delivery --
                        </option>

                        @foreach (var delivery in Model.Deliveries
                        .Where(d =>
                        d.Status != DeliveryStatus.Delivered &&
                        d.Status != DeliveryStatus.Failed))
                        {
                            <option value="@delivery.Id">

                                @delivery.Id.ToString()[..8]
                                -
                                @delivery.Customer?.Name
                                -
                                @delivery.Status

                            </option>
                        }

                    </select>

                </div>

                <!-- DELIVERY STAFF -->

                <div class="mb-3">

                    <label asp-for="AssignmentInput.DeliveryStaffId"
                           class="form-label">
                        Select Delivery Staff
                    </label>

                    <select asp-for="AssignmentInput.DeliveryStaffId"
                            class="form-select">

                        <option value="">
                            -- Select Available Staff --
                        </option>

                        @foreach (var driver in Model.Drivers
                        .Where(d => d.IsAvailable))
                        {
                            <option value="@driver.Id">
                                @driver.Name
                            </option>
                        }

                    </select>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Assign Delivery
                </button>

            </form>

        </div>

    </section>

</div>

<!-- ===================================== -->
<!-- ACCOUNT TYPE FIELD VISIBILITY -->
<!-- ===================================== -->

<script>
    function showAccountFields() {

        const accountType =
            document.getElementById("accountType").value;

        document.getElementById("customerFields").style.display =
            accountType === "Customer" ? "block" : "none";

        document.getElementById("officeStaffFields").style.display =
            accountType === "OfficeStaff" ? "block" : "none";

        document.getElementById("deliveryStaffFields").style.display =
            accountType === "DeliveryStaff" ? "block" : "none";
    }

    document.addEventListener("DOMContentLoaded", showAccountFields);
</script>
