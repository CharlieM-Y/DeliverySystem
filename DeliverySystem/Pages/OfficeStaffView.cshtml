@page
@model DeliverySystem.Pages.OfficeStaffViewModel
@using DeliverySystem.Models

@{
    ViewData["Title"] = "Office Staff Dashboard";
}

<div class="container mt-4">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Office Staff Dashboard</h1>
            <p class="text-muted">
                Welcome, @Model.CurrentStaff?.Name
            </p>
        </div>

        <a asp-page="/Index" class="btn btn-outline-secondary">
            Switch Account
        </a>
    </div>

    <!-- MESSAGES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
             class="alert alert-danger"></div>
    }

    <!-- SUMMARY CARDS -->

    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card bg-light mb-3">
                <div class="card-body">
                    <h6>Total Accounts</h6>
                    <h2>@Model.Accounts.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light mb-3">
                <div class="card-body">
                    <h6>Total Deliveries</h6>
                    <h2>@Model.Deliveries.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light mb-3">
                <div class="card-body">
                    <h6>Unassigned Deliveries</h6>
                    <h2>
                        @Model.Deliveries.Count(
                                 d => d.DeliveryStaffId == null)
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- NAVIGATION -->

    <ul class="nav nav-pills mb-4">
        <li class="nav-item">
            <a class="nav-link" href="#createAccount">
                Create Account
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" href="#createDelivery">
                Create Delivery
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" href="#accounts">
                View Accounts
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" href="#deliveries">
                View Deliveries
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" href="#assignDelivery">
                Assign Driver
            </a>
        </li>
    </ul>

    <!-- CREATE ACCOUNT -->

    <section id="createAccount" class="card mb-4">

        <div class="card-header">
            <h4>Create Account</h4>
        </div>

        <div class="card-body">

            <form method="post"
                  asp-page-handler="CreateAccount">

                <div class="mb-3">
                    <label class="form-label">
                        Account Type
                    </label>

                    <select asp-for="AccountInput.AccountType"
                            id="accountType"
                            class="form-select"
                            onchange="showAccountFields()">

                        <option value="Customer">Customer</option>
                        <option value="OfficeStaff">Office Staff</option>
                        <option value="DeliveryStaff">Delivery Staff</option>

                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input asp-for="AccountInput.Name"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="AccountInput.Email"
                           type="email"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input asp-for="AccountInput.Password"
                           type="password"
                           class="form-control" />
                </div>

                <!-- CUSTOMER FIELDS -->

                <div id="customerFields" class="mb-3">
                    <label class="form-label">
                        Delivery Address
                    </label>

                    <input asp-for="AccountInput.DeliveryAddress"
                           class="form-control" />
                </div>

                <!-- OFFICE STAFF FIELDS -->

                <div id="officeFields"
                     class="mb-3"
                     style="display:none;">

                    <label class="form-label">
                        Department
                    </label>

                    <input asp-for="AccountInput.Department"
                           class="form-control" />
                </div>

                <!-- DELIVERY STAFF FIELDS -->

                <div id="driverFields"
                     class="mb-3"
                     style="display:none;">

                    <div class="form-check">
                        <input asp-for="AccountInput.IsAvailable"
                               class="form-check-input" />
                        <label class="form-check-label">
                            Available
                        </label>
                    </div>

                </div>

                <button type="submit" class="btn btn-primary">
                    Create Account
                </button>

            </form>

        </div>
    </section>

    <!-- CREATE DELIVERY -->

    <section id="createDelivery" class="card mb-4">

        <div class="card-header">
            <h4>Create Delivery</h4>
        </div>

        <div class="card-body">

            <form method="post"
                  asp-page-handler="CreateDelivery">

                <div class="mb-3">
                    <label class="form-label">
                        Customer
                    </label>

                    <select asp-for="DeliveryInput.CustomerId"
                            class="form-select">

                        <option value="">
                            -- Select Customer --
                        </option>

                        @foreach (var customer in Model.Customers)
                        {
                            <option value="@customer.Id">
                                @customer.Name (@customer.Email)
                            </option>
                        }

                    </select>
                </div>

                <h5>Parcel Details</h5>

                <div class="row">

                    <div class="col-md-3 mb-3">
                        <label class="form-label">
                            Length (cm)
                        </label>
                        <input asp-for="DeliveryInput.Length"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">
                            Width (cm)
                        </label>
                        <input asp-for="DeliveryInput.Width"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">
                            Height (cm)
                        </label>
                        <input asp-for="DeliveryInput.Height"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">
                            Weight (kg)
                        </label>
                        <input asp-for="DeliveryInput.Weight"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />
                    </div>

                </div>

                <button type="submit" class="btn btn-primary">
                    Create Delivery
                </button>

            </form>

        </div>
    </section>

    <!-- VIEW ACCOUNTS -->

    <section id="accounts" class="card mb-4">

        <div class="card-header">
            <h4>All Accounts</h4>
        </div>

        <div class="card-body table-responsive">

            <table class="table table-striped table-bordered">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Type</th>
                        <th>Additional Information</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var account in Model.Accounts)
                    {
                        <tr>
                            <td>@account.Name</td>
                            <td>@account.Email</td>
                            <td>@account.GetType().Name</td>

                            <td>
                                @if (account is Customer customer)
                                {
                                    <span>
                                        Address: @customer.DeliveryAddress
                                    </span>
                                }
                                else if (account is OfficeStaff office)
                                {
                                    <span>
                                        Department: @office.Department
                                    </span>
                                }
                                else if (account is DeliveryStaff driver)
                                {
                                    <span>
                                        Available: @driver.IsAvailable
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </section>

    <!-- VIEW DELIVERIES -->

    <section id="deliveries" class="card mb-4">

        <div class="card-header">
            <h4>All Deliveries</h4>
        </div>

        <div class="card-body table-responsive">

            <table class="table table-striped table-bordered">

                <thead>
                    <tr>
                        <th>Delivery ID</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th>Driver</th>
                        <th>Created</th>
                        <th>Parcels</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var delivery in Model.Deliveries)
                    {
                        <tr>
                            <td>
                                <small>@delivery.Id</small>
                            </td>

                            <td>
                                @delivery.Customer?.Name
                            </td>

                            <td>
                                <span class="badge bg-secondary">
                                    @delivery.Status
                                </span>
                            </td>

                            <td>
                                @(delivery.DeliveryStaff?.Name
                                    ?? "Unassigned")
                            </td>

                            <td>
                                @delivery.CreatedAt
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @foreach (var parcel in delivery.Parcels)
                                {
                                    <div class="mb-2">
                                        <strong>Weight:</strong>
                                        @parcel.Weight kg
                                        <br />

                                        <strong>Dimensions:</strong>
                                        @parcel.Length x
                                        @parcel.Width x
                                        @parcel.Height cm
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </section>

    <!-- ASSIGN DELIVERY STAFF -->

    <section id="assignDelivery" class="card mb-5">

        <div class="card-header">
            <h4>Assign Delivery Staff</h4>
        </div>

        <div class="card-body">

            <form method="post"
                  asp-page-handler="AssignDelivery">

                <div class="mb-3">

                    <label class="form-label">
                        Delivery
                    </label>

                    <select asp-for="AssignmentInput.DeliveryId"
                            class="form-select">

                        <option value="">
                            -- Select Delivery --
                        </option>

                        @foreach (var delivery in Model.Deliveries
                        .Where(d =>
                        d.Status != DeliveryStatus.Delivered &&
                        d.Status != DeliveryStatus.Failed))
                        {
                            <option value="@delivery.Id">
                                @delivery.Customer?.Name -
                                @delivery.Status -
                                @delivery.Id.ToString()[..8]
                            </option>
                        }

                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Delivery Staff
                    </label>

                    <select asp-for="AssignmentInput.DeliveryStaffId"
                            class="form-select">

                        <option value="">
                            -- Select Driver --
                        </option>

                        @foreach (var driver in Model.Drivers
                        .Where(d => d.IsAvailable))
                        {
                            <option value="@driver.Id">
                                @driver.Name
                            </option>
                        }

                    </select>

                </div>

                <button type="submit" class="btn btn-success">
                    Assign Driver
                </button>

            </form>

        </div>
    </section>

</div>

@section Scripts {
    <script>
        function showAccountFields() {
            const type = document.getElementById("accountType").value;

            document.getElementById("customerFields").style.display =
                type === "Customer" ? "block" : "none";

            document.getElementById("officeFields").style.display =
                type === "OfficeStaff" ? "block" : "none";

            document.getElementById("driverFields").style.display =
                type === "DeliveryStaff" ? "block" : "none";
        }

        document.addEventListener("DOMContentLoaded", showAccountFields);
    </script>
}
